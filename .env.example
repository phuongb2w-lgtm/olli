# Olli local Supabase (npx supabase status -o env for live values)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only / CI fixture setup (never expose to browser bundles)
# SUPABASE_SECRET_KEY=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=54422
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=postgres

# Generic Docker PostgreSQL verify (scripts/db-verify.ps1)
DOCKER_VERIFY_PORT=54329

# Optional runtime tier override (Vercel sets VERCEL_ENV automatically on hosted deploys)
# OLLI_DEPLOYMENT_TIER=development

# Staff / Owner provisioning (local smokes often set false; production default is invite path — omit or true)
# OLLI_STAFF_PROVISION_USE_INVITE=false
# OLLI_CENTER_PROVISION_USE_INVITE=false
