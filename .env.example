NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only / CI fixture setup (never expose to browser bundles)
# SUPABASE_SECRET_KEY=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=54422
