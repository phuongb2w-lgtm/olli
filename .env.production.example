# Olli production / staging Supabase (placeholders only — never commit real secrets)
# Copy to host secret manager or local .env.production.local (git-ignored) for operator runs.

# --- Client-safe (browser bundle) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon-or-publishable-key>
# Canonical production browser origin (Auth Site URL must match on production Supabase project)
NEXT_PUBLIC_OLLI_CANONICAL_APP_ORIGIN=https://olli.riuda.click

# --- Server-only (Next.js host runtime) ---
SUPABASE_SECRET_KEY=<service-role-secret>

# --- Operator-only (not required by Next.js; used for deploy verification) ---
# Must match the subdomain in NEXT_PUBLIC_SUPABASE_URL
OLLI_SUPABASE_PROJECT_REF=<project-ref>
# Pin expected migration file count for release gates (default: current repo count)
OLLI_EXPECTED_MIGRATION_COUNT=58
# Exact git SHA for production DB deploy (optional but recommended)
# OLLI_RELEASE_GIT_SHA=
# Production Supabase ref — used to block preview hosts from using production DB
# OLLI_PRODUCTION_SUPABASE_PROJECT_REF=<production-project-ref>
# Explicit tier when not on Vercel: production | preview | development
# OLLI_DEPLOYMENT_TIER=production

# --- CI/CD-only (Supabase CLI in non-interactive pipelines) ---
# SUPABASE_ACCESS_TOKEN=

# --- Explicit human confirmation before schema apply (never set in app host) ---
# OLLI_CONFIRM_PRODUCTION_DEPLOY=yes

# Staff provisioning (production default: invite path — omit or set true)
# OLLI_STAFF_PROVISION_USE_INVITE=true

# Optional: include Supabase reachability in GET /api/health (default off)
# OLLI_HEALTH_CHECK_SUPABASE=1

# --- Application smoke (operator machine; not app host) ---
# OLLI_APP_BASE_URL=https://olli.riuda.click
