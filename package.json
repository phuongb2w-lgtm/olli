{
  "name": "olli",
  "private": true,
  "description": "Olli language center management",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint",
    "db:types": "supabase gen types typescript --local > types/database.generated.ts",
    "db:verify:postgres": "powershell -ExecutionPolicy Bypass -File scripts/db-verify.ps1",
    "db:verify:supabase": "powershell -ExecutionPolicy Bypass -File scripts/supabase-verify.ps1",
    "db:verify": "npm run db:verify:supabase",
    "db:seed:auth": "node scripts/seed-auth-users.mjs",
    "test:api": "node scripts/api-security-smoke.mjs",
    "test:app": "playwright test",
    "test:app:install": "playwright install chromium",
    "test:locale": "powershell -ExecutionPolicy Bypass -Command \"Get-Content supabase/tests/m0_locale_tests.sql -Raw | docker exec -i supabase_db_olli-local psql -U postgres -d postgres -v ON_ERROR_STOP=1\"",
    "test:i18n": "node scripts/i18n-key-parity.mjs",
    "test:env": "node scripts/env-secrets-audit.mjs",
    "test:types:stale": "node scripts/check-generated-types.mjs",
    "db:inventory": "node scripts/generate-security-inventory.mjs",
    "test:foundation": "npm run db:verify && npm run test:api && npm run test:app",
    "verify": "npm run db:verify && npm run test:i18n && npm run test:env && npm run lint && npm run typecheck && npm run build && npm run test:api && npm run test:app"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.95.3",
    "next": "16.3.4",
    "next-intl": "^4.14.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.4",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.1.13",
    "@playwright/test": "^1.55.0",
    "wait-on": "^8.0.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
