{
  "name": "olli",
  "private": true,
  "description": "Olli language center management",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "node --max-old-space-size=8192 ./node_modules/eslint/bin/eslint.js .",
    "typecheck": "tsc --noEmit",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint",
    "db:types": "supabase gen types typescript --local > types/database.generated.ts",
    "db:verify:postgres": "powershell -ExecutionPolicy Bypass -File scripts/db-verify.ps1",
    "db:verify:supabase": "powershell -ExecutionPolicy Bypass -File scripts/supabase-verify.ps1",
    "db:verify": "npm run db:verify:supabase",
    "db:seed:auth": "node scripts/seed-auth-users.mjs",
    "test:api": "node scripts/api-security-smoke.mjs",
    "test:staff-provisioning": "node scripts/staff-provisioning-smoke.mjs",
    "test:center-provisioning": "node scripts/center-provisioning-smoke.mjs",
    "test:subscription-commercial": "node scripts/subscription-commercial-smoke.mjs",
    "test:commercial-access": "node scripts/commercial-access-smoke.mjs",
    "test:students": "node scripts/student-list-smoke.mjs && node scripts/student-mutations-smoke.mjs",
    "test:guardians": "node scripts/guardian-relationships-smoke.mjs",
    "test:academic": "node scripts/course-class-smoke.mjs",
    "test:enrollments": "node scripts/enrollment-smoke.mjs",
    "test:teaching": "node scripts/teaching-smoke.mjs",
    "test:operations": "node scripts/operations-smoke.mjs",
    "test:session-operations": "node scripts/session-operations-smoke.mjs",
    "test:operations-analytics": "node scripts/operations-analytics-smoke.mjs",
    "test:operations-daily": "node scripts/operations-daily-smoke.mjs",
    "test:session-execution": "node scripts/session-execution-smoke.mjs",
    "test:assessments": "node scripts/assessment-smoke.mjs",
    "test:reporting": "node scripts/reports-smoke.mjs",
    "test:m1-acceptance": "node scripts/m1-acceptance-scenario.mjs",
    "test:m3-acceptance": "node scripts/m3-acceptance-scenario.mjs",
    "test:crm": "node scripts/crm-leads-smoke.mjs",
    "test:m5-foundation": "node scripts/m5-foundation-smoke.mjs",
    "test:m5-hardening": "node scripts/reporting-period-parse-smoke.mjs",
    "pretest:app": "playwright install chromium",
    "test:app": "playwright test",
    "test:app:install": "playwright install chromium",
    "test:locale": "powershell -ExecutionPolicy Bypass -Command \"Get-Content supabase/tests/m0_locale_tests.sql -Raw | docker exec -i supabase_db_olli-local psql -U postgres -d postgres -v ON_ERROR_STOP=1\"",
    "test:i18n": "node scripts/i18n-key-parity.mjs",
    "test:env": "node scripts/env-secrets-audit.mjs",
    "test:types:stale": "node scripts/check-generated-types.mjs",
    "db:inventory": "node scripts/generate-security-inventory.mjs",
    "test:foundation": "npm run db:verify && npm run test:api && npm run test:app",
    "verify": "npm run db:verify && npm run test:i18n && npm run test:env && npm run lint && npm run typecheck && npm run build && npm run test:api && npm run test:staff-provisioning && npm run test:center-provisioning && npm run test:subscription-commercial && npm run test:commercial-access && npm run test:students && npm run test:guardians && npm run test:academic && npm run test:enrollments && npm run test:teaching && npm run test:operations && npm run test:session-operations && npm run test:operations-analytics && npm run test:operations-daily && npm run test:session-execution && npm run test:assessments && npm run test:reporting && npm run test:m1-acceptance && npm run test:m3-acceptance && npm run test:crm && npm run test:m5-foundation && npm run test:m5-hardening && npm run test:app"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.95.3",
    "next": "16.3.4",
    "next-intl": "^4.14.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.4",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "wait-on": "^8.0.5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
